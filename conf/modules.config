        ]
    ]
  }

  withName: "ZCAT_STATS" 
  {
    ext.args = ''
  }

  withName: "PANDEPTH"
    {
        ext.args = ''
        publishDir = [
            path : { "${params.outdir}/${params.run_id}_${meta.amplicon}/${meta.id}/pandepth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

withName: "SAMTOOLS_DEPTH_COV"
    {
        ext.args = ''
        publishDir = [
            path : { "${params.outdir}/${params.run_id}_${meta.amplicon}/${meta.id}/samtools_depth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


withName: "DATAMASH"
    {
        ext.args = ''
        publishDir = [
            path : { "${params.outdir}/${params.run_id}_${meta.amplicon}/${meta.id}/samtools_depth" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: "MERGE_STATS"
    {
        ext.args = ''
    }

    withName: "SUMMARY_IAV" {
    publishDir = [
        path: { "${params.outdir}/${params.run_id}_IAV/summary" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    apptainer {
        runOptions = "-B /etc/hosts:/etc/hosts"
    }

    }

    withName: "SUMMARY_COV" {
    publishDir = [
        path: { "${params.outdir}/${params.run_id}_COV/summary" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    apptainer {
        runOptions = "-B /etc/hosts:/etc/hosts"
    }

    }

    withName: "SUMMARY_MPX" {
    publishDir = [
        path: { "${params.outdir}/${params.run_id}_MPX/summary" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    }

    withName: "IRMA_SEGMENT_COVERAGE"  {
    publishDir = [
        path: { "${params.outdir}/${params.run_id}_${meta.amplicon}/${meta.id}/irma/segment_coverage" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    }

    
  withName: 'BLAST_MAKEBLASTDB_REFDB' {
    ext.args  = '-dbtype nucl'
  
  }
}


