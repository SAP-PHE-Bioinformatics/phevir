//refs for influenza
// params.tfs_primers                       = projectDir + '/schemas/tfs_primers.fasta'
// params.ref_pan_flu                       = '/scratch/viral/influenza/refs/Pan_Influenza_refseq_genomes.fna.gz'
// params.ref_pan_flu_meta                  = '/scratch/viral/influenza/refs/Pan_Influenza_refseq_genomes.csv'
// params.ref_pan_flu_gff                   = '/scratch/viral/influenza/refs/Pan_Influenza_refseq_genomes.gff'
// params.ref_2024_vaccine_strains          = '/scratch/viral/influenza/refs/2024_vaccine_strains.fna.gz' //vaccine strains from GISAID

// IRMA options
params.irma_module                       = ''
params.keep_ref_deletions                = true
params.skip_irma_subtyping_report        = false

// H/N subtyping options
params.pident_threshold                  = 0.85
params.min_aln_length                    = 700
params.max_top_blastn                    = 5

// reference data
params.ncbi_influenza_fasta              = '/scratch/viral/influenza/refs/ncbi_20241210.fasta.gz' //download refs from NCBI Virus 
params.ncbi_influenza_metadata           = '/scratch/viral/influenza/refs/ncbi_20241210.csv.gz'   //download refs from NCBI Virus 

//Clair3 Variant calling parameter
params.clair3_variant_model              = 'r1041_e82_400bps_sup_v430' //to match basecalling model for Nanopore Dorado, all basecalling done at SA Path SUP model
params.clair3_user_variant_model         = '/scratch/viral/influenza/refs/rerio/clair3_models/r1041_e82_400bps_sup_v430'

// Nanopore/Illumina options
params.skip_mosdepth                     = false

// variant filtering parameters
params.minor_allele_fraction             = 0.25
params.major_allele_fraction             = 0.75
params.low_coverage                      = 10

//vadr args
params.flu_vadr_args                     = '--split --cpu 8 -r --atgonly --xnocomp --nomisc --alt_fail extrant5,extrant3 --mkey flu'
params.flu_vadr_trim_args                = '--minlen 60'